[Unit]
Description=OpenPak Xbox 360 LiveHive endpoint (x360-liveinfo): /liveinfo/GetLiveConfig.ashx, Live service 25

[Container]
ContainerName=openpak-x360-liveinfo
Image=ghcr.io/openpak/x360-liveinfo:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.251
# Traefik routes PathPrefix(/liveinfo) on the plain-HTTP entrypoint to :10025 (XAM dials a dotted IP, no Host header to match).
Environment=X360_LIVEINFO_ADDR=:10025
Environment=X360_LIVEINFO_DEBUG=true
# XAM sends REST Authorization only for HTTPS LiveHive URLs.
Environment=X360_LIVEINFO_HIVE_EXTRA=LiveServiceUrl.progress=https://progress.xboxlive.com;LiveServiceUrl.profile=https://profile.xboxlive.com;EpixXManUriRoot=http://content.xboxlive.com;EpixXManManifestUriPath=/epix/$locale/;StoragePictureUriRoot=profile.xboxlive.com;StoragePictureUriPort=80

[Service]
Restart=always

[Install]
WantedBy=default.target
